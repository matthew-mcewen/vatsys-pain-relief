<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- vatSys itself targets .NET Framework 4.7.2; plugins must match. -->
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>PainReliefPlugin</AssemblyName>
    <RootNamespace>PainRelief</RootNamespace>
    <!-- The plugin's version: the only place to set it. The code reads it from the built DLL.
         Bump major for changes that break existing behaviour, minor for features, patch for fixes. -->
    <Version>1.3.2</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Where vatSys is installed. Override with -p:VatSysDir="..." if yours is elsewhere. -->
    <VatSysDir Condition="'$(VatSysDir)' == ''">C:\Program Files (x86)\vatSys\bin</VatSysDir>

    <!-- vatSys.exe is 32-bit; the plugin is AnyCPU and loads into it fine. -->
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets this build without the .NET Framework 4.7.2 Developer Pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />

    <!-- Private=false: compile against these, but don't copy them next to the plugin. -->
    <Reference Include="vatSys">
      <HintPath>$(VatSysDir)\vatSys.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The VSCS's Direct2D render target, for the VSCS hit-box scaling fix. -->
    <Reference Include="SharpDX">
      <HintPath>$(VatSysDir)\SharpDX.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SharpDX.Direct2D1">
      <HintPath>$(VatSysDir)\SharpDX.Direct2D1.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SharpDX.Mathematics">
      <HintPath>$(VatSysDir)\SharpDX.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RossCarlson.Vatsim.Network">
      <HintPath>$(VatSysDir)\RossCarlson.Vatsim.Network.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The chime played for unaccepted handoffs; sits next to the DLL. -->
    <None Update="chime.wav" CopyToOutputDirectory="PreserveNewest" />
    <!-- Played when a controller refuses a handoff we made. -->
    <None Update="rejected.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Release builds also package the plugin, ready to hand out:
         bin\Release\PainRelief\                    the folder to drop into a profile's Plugins folder
         bin\Release\PainRelief-v<Version>.zip      the same folder, zipped
       The zip holds the PainRelief folder itself, so unzipping into Plugins gives Plugins\PainRelief\. -->
  <Target Name="PackagePlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageStage>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)package\</PackageStage>
      <PackageFolder>$(OutDir)PainRelief\</PackageFolder>
      <PackageZip>$(OutDir)PainRelief-v$(Version).zip</PackageZip>
    </PropertyGroup>
    <ItemGroup>
      <PluginFile Include="$(TargetPath);$(MSBuildProjectDirectory)\chime.wav;$(MSBuildProjectDirectory)\rejected.wav" />
    </ItemGroup>

    <!-- Start clean so files removed from the plugin don't linger in the package. -->
    <RemoveDir Directories="$(PackageStage);$(PackageFolder)" />
    <Copy SourceFiles="@(PluginFile)" DestinationFolder="$(PackageStage)PainRelief" />
    <Copy SourceFiles="@(PluginFile)" DestinationFolder="$(PackageFolder)" />
    <ZipDirectory SourceDirectory="$(PackageStage)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="Packaged $(PackageFolder) and $(PackageZip)" />
  </Target>

</Project>
